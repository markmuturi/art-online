DATABASE_URL=postgres://user:password@localhost:5432/artonline
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000       # used to build the Paystack callback URL after checkout
BETTER_AUTH_SECRET=            # 32+ random characters: openssl rand -base64 32
RESEND_API_KEY=                # leave empty in development to print emails to the console
EMAIL_FROM=Art Online <noreply@yourdomain.co.ke>
PAYSTACK_SECRET_KEY=
PLATFORM_FEE_BPS=              # 250 = 2.5%. Your decision, there is no default.

# Tests only. A superuser connection to the maintenance database. Tests create and drop art_test_* databases.
TEST_DB_ADMIN_URL=postgres://postgres:YOURPASSWORD@localhost:5432/postgres
