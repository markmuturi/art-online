DATABASE_URL=postgres://user:password@localhost:5432/artonline
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000       # used to build the Paystack callback URL after checkout
BETTER_AUTH_SECRET=            # 32+ random characters: openssl rand -base64 32
RESEND_API_KEY=                # leave empty in development to print emails to the console
EMAIL_FROM=Art Online <noreply@yourdomain.co.ke>
PAYSTACK_SECRET_KEY=
PLATFORM_FEE_BPS=              # 250 = 2.5%. Your decision, there is no default.

# Tests only. A superuser connection to the maintenance database. Tests create and drop art_test_* databases.
TEST_DB_ADMIN_URL=postgres://postgres:YOURPASSWORD@localhost:5432/postgres

# Cloudflare R2 (S3-compatible object storage). R2_ENDPOINT is left unset in production -
# the real endpoint is derived from R2_ACCOUNT_ID. Tests set R2_ENDPOINT themselves to point
# at a local test server; you never need to set it by hand.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=art-online-public        # configure this bucket for public read access in the R2 dashboard
R2_PRIVATE_BUCKET=art-online-private      # leave this one with NO public access, ever
R2_PUBLIC_BASE_URL=                       # your r2.dev URL or custom domain for R2_PUBLIC_BUCKET
