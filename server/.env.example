# Copy this file to .env and fill in real values. .env is git-ignored and stays on your machine.
# Comments sit on their own lines on purpose: some tools read a trailing "# ..." as part of the value.

# --- Database used by the site, the worker and `npm run db:migrate` -------------------------
# Use the postgres user and the password you chose when installing Postgres. If the password has
# special characters, encode them: @ is %40, # is %23, / is %2F, : is %3A, % is %25.
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/artonline

# --- Site address and sign-in -----------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# 32 or more random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# --- Email ---------------------------------------------------------------------------------
# Leave RESEND_API_KEY empty while developing: verification emails print in the terminal that is
# running `npm run dev`. In production an empty key means no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Art Online <noreply@yourdomain.co.ke>

# --- Paystack and fees ---------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
# Platform fee in basis points: 250 means 2.5%. This is your decision, there is no default.
PLATFORM_FEE_BPS=250

# --- Cloudflare R2 (S3-compatible object storage) -------------------------------------------
# R2_ENDPOINT is left unset in real use: the endpoint is derived from R2_ACCOUNT_ID. The tests set
# it themselves to point at a local stand-in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Configure this bucket for public read access in the R2 dashboard.
R2_PUBLIC_BUCKET=art-online-public
# Leave this one with NO public access, ever.
R2_PRIVATE_BUCKET=art-online-private
# Your r2.dev address or custom domain for the public bucket.
R2_PUBLIC_BASE_URL=

# --- Tests only (read from your terminal session, not from this file) -------------------------
# A superuser connection to the maintenance database. Tests create and drop art_test_* databases.
TEST_DB_ADMIN_URL=postgres://postgres:YOURPASSWORD@localhost:5432/postgres
